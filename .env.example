# ===== Local development only =====
# Copy this file to .env.local for local development.
# Never commit the real .env.local file (it's already in .gitignore).
#
# In production (Vercel), set these same variables under:
# Project Settings -> Environment Variables

# Used by /api/claude.js (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Used by src/supabaseClient.js (safe to expose to the browser — these are
# Supabase's public "anon" credentials, not secret keys; real security comes
# from the Row Level Security rules set up in supabase-setup.sql)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
